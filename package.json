{
  "name": "dbju",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && (prisma skills sync >/dev/null 2>&1 || exit 0)",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "storage:migrate": "tsx --env-file-if-exists=.env scripts/migrate-uploads-to-s3.ts",
    "cron": "tsx --env-file-if-exists=.env scripts/cron.ts",
    "db:export": "bash scripts/db-export.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@google/genai": "^3.2.0",
    "@prisma/client": "^5.22.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
