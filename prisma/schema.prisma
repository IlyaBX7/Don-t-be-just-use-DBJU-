generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// Таблиця Користувачів
model User {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(100) // повне ім'я для показу = firstName + lastName
  firstName     String    @default("") @db.VarChar(50)
  lastName      String    @default("") @db.VarChar(50)
  email         String    @unique @db.VarChar(191)
  password      String    @db.VarChar(255) // scrypt: "salt:hash"
  role          Role      @default(USER)
  rating        Float     @default(0) // середня оцінка з таблиці Review (0 — відгуків ще немає)
  reviewsCount  Int       @default(0)
  isVerified    Boolean   @default(false) // підтверджено через Дію
  verifiedAt    DateTime?
  phone         String?   @db.VarChar(32)
  avatar        String?   @db.VarChar(255) // ініціали
  avatarUrl     String?   @db.VarChar(255) // фото профілю (/api/uploads/...)
  bio           String?   @db.VarChar(500) // «Про себе» на публічній сторінці
  verifiedVia   String?   @db.VarChar(16) // DIIA | BANKID (демо)
  blockedAt     DateTime? // заблоковано адміністратором
  blockedReason String?   @db.VarChar(300)
  referralCode  String?   @unique @db.VarChar(16)
  referredById  String?

  products        Product[]
  sessions        Session[]
  favorites       Favorite[]
  rentals         Booking[]             @relation("RenterBookings")
  ownerOrders     Booking[]             @relation("OwnerBookings")
  payouts         Payout[]
  cards           PaymentCard[]
  reviewsWritten  Review[]              @relation("ReviewAuthor")
  reviewsReceived Review[]              @relation("ReviewTarget")
  referredBy      User?                 @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]                @relation("Referrals")
  messages        Message[]
  notifications   Notification[]
  itemRequests    ItemRequest[]
  requestOffers   RequestOffer[]
  bonuses         BonusTransaction[]
  reportsMade     Report[]              @relation("ReportAuthor")
  reportsAgainst  Report[]              @relation("ReportTargetUser")
  disputesOpened  Dispute[]             @relation("DisputeOpener")
  verifications   VerificationRequest[]

  plusUntil DateTime? // підписка DBJU+ активна до цієї дати

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

// Таблиця Сесій (вхід користувача)
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @db.Char(64) // sha256 від токена з cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?  @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Category {
  repair
  home
  tech
  tourism
  sport
  kids
  transport
  gaming
  pets
  garden
  events
  music
  fashion
}

enum ProductStatus {
  AVAILABLE
  RENTED
  HIDDEN
}

// Таблиця Товарів (ціни — цілі гривні)
model Product {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(150)
  fullTitle   String?  @db.VarChar(255)
  description String   @db.Text
  category    Category
  images      Json // масив URL зображень

  rentalPricePerDay Int
  price3Days        Int? // ціна за 3 доби (якщо є знижка)
  priceWeek         Int? // ціна за тиждень
  depositAmount     Int
  minRentDays       Int  @default(1)
  marketBuyPrice    Int? // ціна нового в магазині
  purchasePrice     Int? // ціна викупу у власника
  buybackPercent    Int  @default(30)

  location String  @db.VarChar(150)
  city     String? @db.VarChar(80) // місто (з довідника або введене вручну)
  region   String? @db.VarChar(80) // область
  street   String? @db.VarChar(150) // вулиця, будинок
  lat      Float? // точка на карті (необов'язково)
  lng      Float?

  status      ProductStatus @default(AVAILABLE)
  condition   String        @default("GOOD") @db.VarChar(32)
  includedKit Json? // масив рядків
  features    Json? // об'єкт { "Потужність": "800 Вт" }
  rentalCount Int           @default(0)

  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  favorites     Favorite[]
  requestOffers RequestOffer[]
  reports       Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([ownerId])
  @@index([city])
}

enum DeliveryMethod {
  PICKUP
  COURIER
}

// Етапи оренди: оплачено → отримано → повернуто (фотозвіт) → завершено власником
enum BookingStatus {
  PAID
  PICKED_UP
  RETURNED
  DISPUTED
  COMPLETED
  CANCELLED
}

// Таблиця Бронювань (оренд)
model Booking {
  id   String @id @default(uuid())
  code String @unique @db.VarChar(32) // код замовлення

  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  renterId  String
  renter    User      @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User      @relation("OwnerBookings", fields: [ownerId], references: [id], onDelete: Cascade)
  reviews   Review[]
  messages  Message[]
  dispute   Dispute?

  startDate DateTime @db.Date
  endDate   DateTime @db.Date // включно
  days      Int

  deliveryMethod  DeliveryMethod
  deliveryAddress String?        @db.VarChar(255)
  rentAmount      Int
  deliveryCost    Int
  protection      Boolean        @default(true)
  protectionCost  Int
  serviceFee      Int
  ownerCommission Int            @default(0) // комісія з власника (15% від оренди)
  ownerPayout     Int            @default(0) // отримує власник = оренда − комісія
  totalAmount     Int
  depositAmount   Int

  status            BookingStatus @default(PAID)
  returnPhoto       String?       @db.VarChar(255)
  pickupPhotos      Json? // фото стану при отриманні (орендар)
  handoverPhotos    Json? // фото стану при передачі (власник)
  ownerCompensation Int           @default(0) // компенсація власнику за пошкодження (із застави / страхового фонду)
  bonusUsed         Int           @default(0) // скільки бонусів орендар використав на цю оренду
  ownerNote         String?       @db.VarChar(500)

  paidAt      DateTime  @default(now())
  pickedUpAt  DateTime?
  returnedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId, startDate])
  @@index([renterId])
  @@index([ownerId])
}

// Обране (список бажань)
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}

// Виведення заробітку власником
model Payout {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  card      String   @db.VarChar(32)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Банківські картки для виплат. Повний номер НЕ зберігається — лише останні 4 цифри.
model PaymentCard {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     String   @db.VarChar(16) // visa | mastercard | other
  last4     String   @db.Char(4)
  expMonth  Int
  expYear   Int
  holder    String   @db.VarChar(100)
  label     String?  @db.VarChar(50) // напр. "monobank"
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ReviewRole {
  OWNER // відгук про власника (пише орендар)
  RENTER // відгук про орендаря (пише власник)
}

// Відгуки після завершеної оренди: кожна сторона може залишити один відгук про іншу
model Review {
  id         String     @id @default(uuid())
  bookingId  String
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId   String
  author     User       @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId   String
  target     User       @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetRole ReviewRole
  rating     Int // 1–5
  text       String?    @db.VarChar(1000)
  createdAt  DateTime   @default(now())

  @@unique([bookingId, authorId])
  @@index([targetId, createdAt])
}

// Повідомлення між орендарем і власником у межах бронювання
model Message {
  id        String    @id @default(uuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String    @db.VarChar(2000)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([bookingId, createdAt])
}

// Сповіщення на сайті (дзвіночок у хедері)
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(150)
  body      String?   @db.VarChar(500)
  link      String?   @db.VarChar(255)
  dedupeKey String?   @unique @db.VarChar(191) // щоб нагадування не дублювалися
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

enum DisputeStatus {
  OPEN // власник повідомив про пошкодження, чекаємо відповіді орендаря
  CONTESTED // орендар не згоден — вирішує адміністратор
  RESOLVED
}

// Суперечка про стан речі після повернення
model Dispute {
  id                 String        @id @default(uuid())
  bookingId          String        @unique
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedById         String
  openedBy           User          @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)
  reason             String        @db.Text
  photos             Json
  claimAmount        Int // скільки власник просить компенсувати
  status             DisputeStatus @default(OPEN)
  renterResponse     String?       @db.Text
  resolution         String?       @db.Text
  awardedFromDeposit Int           @default(0)
  awardedFromFund    Int           @default(0) // понад заставу — зі страхового фонду DBJU
  resolvedById       String?
  createdAt          DateTime      @default(now())
  resolvedAt         DateTime?

  @@index([status])
}

enum RequestStatus {
  OPEN
  CLOSED
}

// «Запити на речі»: люди пишуть, що шукають, власники пропонують свої оголошення
model ItemRequest {
  id             String         @id @default(uuid())
  authorId       String
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String         @db.VarChar(150)
  description    String?        @db.VarChar(1000)
  category       Category?
  city           String?        @db.VarChar(80)
  maxPricePerDay Int?
  neededFrom     DateTime?      @db.Date
  neededTo       DateTime?      @db.Date
  status         RequestStatus  @default(OPEN)
  offers         RequestOffer[]
  createdAt      DateTime       @default(now())

  @@index([status, createdAt])
}

model RequestOffer {
  id        String      @id @default(uuid())
  requestId String
  request   ItemRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  message   String?     @db.VarChar(500)
  createdAt DateTime    @default(now())

  @@unique([requestId, productId])
}

// Бонуси (реферальна програма): + нарахування, − використання при оплаті
model BonusTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String   @db.VarChar(40) // REFERRAL_INVITER | REFERRAL_INVITEE | BOOKING | BOOKING_REFUND
  bookingId String?
  uniqueKey String?  @unique @db.VarChar(191) // захист від подвійного нарахування
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ReportTarget {
  PRODUCT
  USER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Скарги на оголошення чи користувача
model Report {
  id           String       @id @default(uuid())
  reporterId   String
  reporter     User         @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTarget
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?        @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  reason       String       @db.VarChar(40)
  details      String?      @db.VarChar(1000)
  status       ReportStatus @default(OPEN)
  adminNote    String?      @db.VarChar(500)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
}

// Ліміти спроб (вхід, реєстрація, помічник) — у базі, щоб працювало на кількох серверах
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String   @db.VarChar(191)
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Демо-верифікація через Дію / BankID
model VerificationRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    String   @db.VarChar(16) // DIIA | BANKID
  bank      String?  @db.VarChar(40)
  code      String   @db.VarChar(16)
  status    String   @default("PENDING") @db.VarChar(16) // PENDING | SCANNED | CONFIRMED
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
