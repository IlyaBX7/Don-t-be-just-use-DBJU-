# Скопіюйте у .env (локально) або впишіть у налаштуваннях хостингу. Справжні ключі сюди НЕ комітьте.

# ---------------- База даних ----------------
# Локально (docker compose up -d) — як нижче; на хостингу — адреса бази MySQL / MariaDB від хостингу.
DATABASE_URL="mysql://root:rootpassword@localhost:3306/dbju"

# ---------------- Адміністратор ----------------
# npm run db:seed створює або оновлює адміна з цими даними.
# Локально без ADMIN_PASSWORD — тестовий пароль admin123 (на сервері він не діє).
# На сервері пароль обов'язковий, щонайменше 12 символів.
# ADMIN_EMAIL="admin@dbju.ua"
# ADMIN_PASSWORD=""

# Публічна адреса сайту (необов'язково), наприклад https://dbju.com.ua — для превʼю посилань у соцмережах
# NEXT_PUBLIC_SITE_URL=""

# ---------------- ШІ-помічник ----------------
# Постачальник: "gemini" — тестовий режим на безкоштовному тарифі Google; без цього рядка — Claude.
# AI_PROVIDER="gemini"

# Google Gemini (тест): ключ з https://aistudio.google.com → Get API key
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"

# Claude (основний): ключ з https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=""

# ---------------- Сховище фотографій ----------------
# Без STORAGE_DRIVER фото зберігаються локально в папці uploads/ — лише для роботи на своєму комп'ютері.
# На хостингу диск тимчасовий, тож там обов'язково STORAGE_DRIVER="s3" і ключі одного з варіантів нижче.
# Перенести вже завантажені фото в хмару: npm run storage:migrate

# --- Cloudflare R2 (рекомендовано: 10 ГБ безкоштовно, без плати за трафік) ---
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="dbju-photos"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."

# --- Amazon S3 ---
# STORAGE_DRIVER="s3"
# S3_REGION="eu-central-1"
# S3_BUCKET="dbju-photos"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."

# --- Локальна перевірка (docker compose --profile s3 up -d) ---
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="http://localhost:9090"
# S3_REGION="us-east-1"
# S3_BUCKET="dbju-photos"
# S3_ACCESS_KEY_ID="test"
# S3_SECRET_ACCESS_KEY="test"
# S3_FORCE_PATH_STYLE="true"

# Необов'язково: префікс («папка») у бакеті, за замовчуванням "uploads/"
# S3_PREFIX="uploads/"
